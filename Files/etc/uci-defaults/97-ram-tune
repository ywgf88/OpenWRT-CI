#!/bin/sh
# SPDX-License-Identifier: MIT
#
# 1G 内存调优（首启执行一次，设置写入 /etc 长期保留）：
#   1. dnsmasq 缓存 1500 -> 8192
#   2. system 日志环缓冲 64KB -> 128KB
#   3. 内核网络缓冲放大（rmem/wmem 16MiB、tcp_rmem/tcp_wmem、conntrack_max）
#   4. 启用 homeproxy 看板重定向到 /tmp
#
# 全部是"内存换速度/换 flash"的项，1G 内存机型收益明显；任一步失败都不阻塞首启。

SYSCTL=/etc/sysctl.conf

set_sysctl() {
	[ -f "$SYSCTL" ] || return 0
	sed -i "/^$1=/d" "$SYSCTL" 2>/dev/null
	echo "$1=$2" >> "$SYSCTL"
}

# 内核网络缓冲：默认 rmem_max 只有 208KB，长肥管道会被限速
set_sysctl net.core.rmem_max 16777216
set_sysctl net.core.wmem_max 16777216
set_sysctl net.ipv4.tcp_rmem "4096 87380 16777216"
set_sysctl net.ipv4.tcp_wmem "4096 65536 16777216"
set_sysctl net.netfilter.nf_conntrack_max 65536

sysctl -p >/dev/null 2>&1

# DNS 缓存
if uci -q get dhcp.@dnsmasq[0] >/dev/null 2>&1; then
	uci -q set dhcp.@dnsmasq[0].cachesize='8192'
	uci -q commit dhcp
fi

# 日志环缓冲（KB），方便排查又不写盘
if uci -q get system.@system[0] >/dev/null 2>&1; then
	uci -q set system.@system[0].log_size='256'
	uci -q commit system
fi

# 看板重定向：注册开机脚本并立刻执行一次
if [ -x /etc/init.d/homeproxy-ram ]; then
	/etc/init.d/homeproxy-ram enable >/dev/null 2>&1
	/etc/init.d/homeproxy-ram start >/dev/null 2>&1
fi

logger -t ram-tune "1G memory tuning applied"
exit 0
